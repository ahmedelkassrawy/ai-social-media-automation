    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.media_asset_id, s.caption, a.page_access_token, a.ig_business_id, m.external_url, m.media_type\nFROM scheduled s\nJOIN media_assets m ON s.media_asset_id = m.id\nJOIN accounts a ON m.account_id = a.id\nWHERE s.state = 'CAPTIONED'\nAND s.scheduled_at <= NOW() AT TIME ZONE 'Africa/Cairo'\nAND s.caption IS NOT NULL;\n",
        "options": {}
      },
